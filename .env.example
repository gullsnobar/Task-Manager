# Port the Express server listens on (Cloud Run sets this automatically)
PORT=5000

# MongoDB connection string (the hostname matches the Compose service)
MONGO_URI=mongodb://mongo:27017/taskmanager

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=replace-this-with-a-long-random-string

# Runtime environment: development | production
NODE_ENV=development
